# Скопіюйте в .streamlit/secrets.toml (локально) або вставте в Streamlit Community Cloud:
# App → Settings → Secrets. Усі ключі необов'язкові: значення лише підставляються у форми.

M2M_URL = "https://my.m2m.eu"

# Команда, яка одразу підставляється на вкладці «1 · Створення команди»
DEFAULT_COMMAND_NAME = "NTP"
DEFAULT_COMMAND_TEXT = "runcmd:@com_tsync_disallow:1"
